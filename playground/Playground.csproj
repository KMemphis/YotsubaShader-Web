<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YotsubaShader.Playground</RootNamespace>
    <AssemblyName>Playground</AssemblyName>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <InvariantGlobalization>true</InvariantGlobalization>
      </PropertyGroup>

  <!-- The playground only references the compiler projects; it never modifies them. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Representations\YotsubaShader.Language\YotsubaShader.Language.csproj" />
    <ProjectReference Include="..\..\Core\Syntax\YotsubaShader.GlslSyntax\YotsubaShader.GlslSyntax.csproj" />
    <ProjectReference Include="..\..\Core\Syntax\YotsubaShader.HlslSyntax\YotsubaShader.HlslSyntax.csproj" />
    <ProjectReference Include="..\..\Core\Syntax\YotsubaShader.MslSyntax\YotsubaShader.MslSyntax.csproj" />
    <ProjectReference Include="..\..\Core\Syntax\YotsubaShader.SpirvSyntax\YotsubaShader.SpirvSyntax.csproj" />
    <ProjectReference Include="..\..\Core\Syntax\YotsubaShader.WgslSyntax\YotsubaShader.WgslSyntax.csproj" />
    <ProjectReference Include="..\..\Core\Representations\YotsubaShader.IR\YotsubaShader.IR.csproj" />
    <ProjectReference Include="..\..\Core\YotsubaShader.Compiler.Library\YotsubaShader.Compiler.Library.csproj" />
    <ProjectReference Include="..\..\Core\Analyzers\YotsubaShader.Roslyn\YotsubaShader.Roslyn.csproj" />
  </ItemGroup>

  <!-- Roslyn needs the raw metadata of YotsubaShader.Language, YotsubaShader.Concepts and the *Syntax attribute
       vocabularies to resolve their attributes. The runtime cannot hand it out (Webcil + Mono), so each built DLL
       travels inside the app as an embedded resource. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Core\Representations\YotsubaShader.Language\bin\$(Configuration)\netstandard2.0\YotsubaShader.Language.dll"
                      LogicalName="YotsubaShader.Language.dll" Visible="false" />
    <EmbeddedResource Include="..\..\Core\Syntax\YotsubaShader.Concepts\bin\$(Configuration)\netstandard2.0\YotsubaShader.Concepts.dll"
                      LogicalName="YotsubaShader.Concepts.dll" Visible="false" />
    <EmbeddedResource Include="..\..\Core\Syntax\YotsubaShader.GlslSyntax\bin\$(Configuration)\netstandard2.0\YotsubaShader.GlslSyntax.dll"
                      LogicalName="YotsubaShader.GlslSyntax.dll" Visible="false" />
    <EmbeddedResource Include="..\..\Core\Syntax\YotsubaShader.HlslSyntax\bin\$(Configuration)\netstandard2.0\YotsubaShader.HlslSyntax.dll"
                      LogicalName="YotsubaShader.HlslSyntax.dll" Visible="false" />
    <EmbeddedResource Include="..\..\Core\Syntax\YotsubaShader.MslSyntax\bin\$(Configuration)\netstandard2.0\YotsubaShader.MslSyntax.dll"
                      LogicalName="YotsubaShader.MslSyntax.dll" Visible="false" />
    <EmbeddedResource Include="..\..\Core\Syntax\YotsubaShader.SpirvSyntax\bin\$(Configuration)\netstandard2.0\YotsubaShader.SpirvSyntax.dll"
                      LogicalName="YotsubaShader.SpirvSyntax.dll" Visible="false" />
    <EmbeddedResource Include="..\..\Core\Syntax\YotsubaShader.WgslSyntax\bin\$(Configuration)\netstandard2.0\YotsubaShader.WgslSyntax.dll"
                      LogicalName="YotsubaShader.WgslSyntax.dll" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <!-- Same Roslyn version as YotsubaShader.Roslyn. Workspaces + Features give completion, hover and quick info. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <!-- Reference assemblies for the BCL, since the browser has no SDK on disk. -->
    <PackageReference Include="Basic.Reference.Assemblies.Net80" Version="1.*" />
  </ItemGroup>

  <!-- Roslyn Workspaces reaches SpinLock through metadata while initializing its solution cache. -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
