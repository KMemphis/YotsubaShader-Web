<Project Sdk="Microsoft.NET.Sdk">
    <!-- Local tool: compiles every generated example with the IDE analyzer so a broken one fails the build.
         The examples are generated by ../tools/build-examples.mjs into gen/ (git-ignored). -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="gen/**/*.cs" />
        <ProjectReference Include="../../../Core/Analyzers/YotsubaShader.IDE.Analyzer/YotsubaShader.IDE.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../../Core/Syntax/YotsubaShader.HlslSyntax/YotsubaShader.HlslSyntax.csproj" />
        <ProjectReference Include="../../../Core/Syntax/YotsubaShader.GlslSyntax/YotsubaShader.GlslSyntax.csproj" />
        <ProjectReference Include="../../../Core/Syntax/YotsubaShader.MslSyntax/YotsubaShader.MslSyntax.csproj" />
        <ProjectReference Include="../../../Core/Syntax/YotsubaShader.SpirvSyntax/YotsubaShader.SpirvSyntax.csproj" />
        <ProjectReference Include="../../../Core/Syntax/YotsubaShader.WgslSyntax/YotsubaShader.WgslSyntax.csproj" />
    </ItemGroup>
</Project>
